{
  "name": "tactical-x-band-air-to-ground-network",
  "version": "1.2.0",
  "description": "TypeScript WebWorker digital twin for X-band air-to-ground TDMA research and simulation.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run_all_verifications.mjs",
    "verify": "node scripts/verify-project.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "verify:quad-antenna": "vite-node src/tests/verifyQuadSectorAntenna.ts",
    "verify:variable-altitude": "vite-node src/tests/verifyVariableAltitude.ts",
    "verify:variable-tdma": "vite-node src/tests/verifyVariableTdma.ts",
    "verify:simulation-timeline": "vite-node src/tests/verifySimulationTimeline.ts",
    "verify:timeline-e2e": "vite-node src/tests/verifyTimelineBrowserE2E.ts",
    "verify:map-layers": "vite-node src/tests/verifyMapLayerSystem.ts",
    "verify:timeline-enhancement": "vite-node src/tests/verifyTimelineEnhancement.ts",
    "verify:timeline-corrective": "vite-node src/tests/verifyTimelineCorrective.ts",
    "verify:terrain-toolbox": "vite-node src/tests/verifyTerrainToolboxSci.ts",
    "verify:itu-physics": "vite-node src/tests/verifyItuFirstPrinciples.ts",
    "verify:ablation": "vite-node src/tests/verifyAblationAndDiffraction.ts",
    "verify:scientific-instruments": "vite-node src/tests/verifyScientificInstruments.ts",
    "verify:doppler-ew": "vite-node src/tests/verifyDopplerAndEwJammer.ts",
    "verify:viewshed-relay": "vite-node src/tests/verifyViewshedAndRelayAdvisor.ts",
    "verify:publication-ecdf": "vite-node src/tests/verifyPublicationEcdfAndLatex.ts",
    "verify:browser": "node scripts/verify-browser-ux.mjs",
    "verify:all": "node scripts/run_all_verifications.mjs",
    "typecheck": "tsc --noEmit",
    "benchmark:ts": "vite-node scripts/run_ts_benchmark.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-node": "3.2.4"
  }
}
