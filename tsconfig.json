{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "types": ["vite/client"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/core/**/*",
    "src/shared/**/*",
    "src/worker/**/*",
    "src/ui/**/*"
  ]
}
